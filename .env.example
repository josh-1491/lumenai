ANTHROPIC_API_KEY=
PORT=8787

# Only needed if your Anthropic key isn't scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# Where the frontend runs — OAuth callbacks redirect back here when done.
APP_BASE_URL=http://localhost:5173

# Connected accounts (optional) — "Connect" is disabled per-platform in the UI
# until its client id is set. Register redirect URIs with each provider as
# {API_BASE_URL or http://localhost:<PORT>}/auth/<provider>/callback.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# YouTube and Gmail use a Google OAuth client. Enable the YouTube Data API and
# Gmail API in Google Cloud. YouTube redirect URI:
# {API_BASE_URL or http://localhost:<PORT>}/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yahoo Mail requires a Yahoo developer app with Yahoo Mail API read access.
# Register this callback URI and select the mail-r permission for the app:
# {API_BASE_URL or http://localhost:<PORT>}/auth/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Facebook and Instagram use the same Facebook app credentials. Register
# /auth/facebook/callback and /auth/instagram/callback as valid OAuth redirect URIs.
# TikTok uses Login Kit credentials; register /auth/tiktok/callback as its redirect URI.
# All redirect URIs use API_BASE_URL when set, otherwise http://localhost:<PORT>.

# Telegram and WhatsApp need no server config — users paste their bot token
# (from @BotFather) / WhatsApp Cloud API credentials in the Connected accounts dialog.
